# Copie para .env e preencha. Nunca commite o .env.

# Neo4j (usado pelo docker-compose e pelo código)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha

# LLM — chave grátis em https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash

# Embeddings locais (sentence-transformers). bge-m3: 1024 dimensões, sem prefixo.
EMBEDDING_MODEL=BAAI/bge-m3
